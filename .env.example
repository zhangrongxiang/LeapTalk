# Doubao realtime dialogue uses this credential pair.
DOUBAO_APP_ID=YOUR_DOUBAO_APP_ID
DOUBAO_ACCESS_TOKEN=YOUR_DOUBAO_ACCESS_TOKEN

# Optional fallback for newer console auth. If both are set, App ID/Access Token is used first.
# DOUBAO_API_KEY=YOUR_DOUBAO_API_KEY

DOUBAO_WS_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
DOUBAO_VOICE_TYPE=温柔文雅
DOUBAO_BOT_NAME=LeapTalk
DOUBAO_SYSTEM_PROMPT=你是一个自然、简洁、友好的数字人助手。
DOUBAO_SPEAKING_STYLE=你的回答要口语化，适合语音播报，通常控制在三句话以内。

LEAPTALK_CKPT_DIR=./models/SoulX-FlashHead-1_3B
LEAPTALK_WAV2VEC_DIR=./models/wav2vec2-base-960h
LEAPTALK_LORA_DIR=./models/leaptalk
LEAPTALK_AUDIO_PROJ=./models/leaptalk/audio_proj_step_10400.pt
LEAPTALK_COMPILE=off
LEAPTALK_NUM_INFERENCE_STEPS=1
LEAPTALK_LITE=1
LEAPTALK_WEB_HOST=0.0.0.0
LEAPTALK_WEB_PORT=7860
CUDA_VISIBLE_DEVICES=0
